    {
        "id": "fn_decode_mestre",
        "type": "function",
        "z": "tab_mestre_231",
        "name": "Decodifica e Formata",
        "func": "if (!msg.modbusRequest) return null;\nconst varName = msg.modbusRequest.name;\nconst meta = flow.get('vars_meta_mestre') || [];\nconst varInfo = meta.find(v => v.name === varName);\n\nif (!varInfo || !Array.isArray(msg.payload) || msg.payload.length === 0) return null;\n\nconst varType = varInfo.type;\nconst bitPos = varInfo.bit || 0;\nlet val = null;\n\nif (varType === 'f32') {\n    if (msg.payload.length < 2) return null;\n    const reg_low  = msg.payload[0];\n    const reg_high = msg.payload[1];\n    const buf = Buffer.alloc(4);\n    buf.writeUInt16BE(reg_high & 0xFFFF, 0);\n    buf.writeUInt16BE(reg_low  & 0xFFFF, 2);\n    val = buf.readFloatBE(0);\n} else if (varType === 'bit') {\n    const word = msg.payload[0];\n    val = (word >> bitPos) & 1;\n}\n\nif (val === null || !Number.isFinite(val)) return null;\n\nmsg.measurement = 'plc_data';\nmsg.tags = { plc: 'mestre_231' };\nmsg.payload = {\n    fields: { [varName]: val },\n    timestamp: Date.now()\n};\n\nreturn msg;",
