    {
        "id": "24cb3f48659fa201",
        "type": "function",
        "z": "1c0c0bc83bf38023",
        "name": "Decodifica e Formata",
        "func": "if (!msg.modbusRequest) {\n    node.warn('Requisição não encontrada na mensagem.');\n    return null;\n}\n\nconst varName = msg.modbusRequest.name;\nconst meta = flow.get('vars_meta_220') || [];\nconst varInfo = meta.find(v => v.name === varName);\n\nif (!varInfo) {\n    node.warn('Configuração não encontrada para ' + varName);\n    return null;\n}\n\nconst varType = varInfo.type;\n\nif (!Array.isArray(msg.payload) || msg.payload.length === 0) {\n    node.warn('Payload Modbus inválido para ' + varName);\n    return null;\n}\n\nlet val = null;\n\nif (varType === 'f32') {\n    if (msg.payload.length < 2) return null;\n    const reg_low  = msg.payload[0];\n    const reg_high = msg.payload[1];\n    const buf = Buffer.alloc(4);\n    buf.writeUInt16BE(reg_high & 0xFFFF, 0);\n    buf.writeUInt16BE(reg_low  & 0xFFFF, 2);\n    val = buf.readFloatBE(0);\n}\n\nif (val === null || !Number.isFinite(val)) {\n    node.warn('Valor inválido para ' + varName + '. Registradores brutos: [' + msg.payload[0] + ', ' + msg.payload[1] + ']');\n    return null;\n}\n\nmsg.measurement = 'plc_data';\nmsg.tags = { plc: '220' };\nmsg.payload = {\n    fields: { [varName]: val },\n    timestamp: Date.now()\n};\n\nreturn msg;",
