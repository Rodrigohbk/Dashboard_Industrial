    {
        "id": "req_08",
        "type": "function",
        "z": "tab_moenda_224",
        "name": "req 4X:8191.1",
        "func": "// Lendo 1 registrador a partir do endereço 8190 (4X:8191 - 1)\nmsg.payload = { value: 'read', fc: 3, unitid: 255, address: 8190, quantity: 1 };\nmsg.topic = 'Moenda.EmOperacao.Status';\nreturn msg;",
        "outputs": 1,
        "x": 390,
        "y": 500,
        "wires": [
            [
                "get_08"
            ]
        ]
    },
    {
        "id": "get_08",
        "type": "modbus-flex-getter",
        "z": "tab_moenda_224",
        "name": "Get EmOperacao Status",
        "showStatusActivities": true,
        "showErrors": true,
        "server": "cfg_modbus_224",
        "emptyMsgOnFail": false,
        "keepMsgProperties": true,
        "x": 620,
        "y": 500,
        "wires": [
            [
                "fn_decode_bit"
            ],
            []
        ]
    },
    {
        "id": "fn_decode_f32",
        "type": "function",
        "z": "tab_moenda_224",
        "name": "Decodifica Float32 (CDAB)",
        "func": "if (!Array.isArray(msg.payload) || msg.payload.length < 2) {\n    node.warn('Float payload inesperado: ' + msg.topic);\n    return null;\n}\nconst reg_low  = msg.payload[0];\nconst reg_high = msg.payload[1];\nconst buf = Buffer.alloc(4);\nbuf.writeUInt16BE(reg_high & 0xFFFF, 0);\nbuf.writeUInt16BE(reg_low  & 0xFFFF, 2);\nconst val = buf.readFloatBE(0);\n\nif (!Number.isFinite(val)) return null;\n\nmsg.measurement = 'plc_data';\nmsg.tags = { plc: 'Moenda' };\nmsg.payload = {\n    fields: { [msg.topic]: val },\n    timestamp: Date.now()\n};\nreturn msg;",
        "outputs": 1,
        "x": 880,
        "y": 290,
        "wires": [
            [
                "influx_out",
                "dbg_ok"
            ]
        ]
    },
    {
        "id": "fn_decode_bit",
        "type": "function",
        "z": "tab_moenda_224",
        "name": "Decodifica Bit",
        "func": "if (!Array.isArray(msg.payload) || msg.payload.length < 1) {\n    node.warn('Bit payload inesperado: ' + msg.topic);\n    return null;\n}\nconst word = msg.payload[0];\n// Extrai o bit 1 (segundo bit)\nconst val = (word >> 1) & 1;\n\nmsg.measurement = 'plc_data';\nmsg.tags = { plc: 'Moenda' };\nmsg.payload = {\n    fields: { [msg.topic]: val },\n    timestamp: Date.now()\n};\nreturn msg;",
        "outputs": 1,
        "x": 840,
        "y": 500,
        "wires": [
            [
                "influx_out",
                "dbg_ok"
            ]
        ]
    },
    {
        "id": "influx_out",
        "type": "influxdb3-write",
        "z": "tab_moenda_224",
        "influxdb": "cfg_influx3_mvp",
        "name": "InfluxDB 3 Core (vhp_mvp)",
        "measurement": "",
        "database": "",
        "allowPartialWrites": false,
        "noSync": false,
        "x": 1130,
        "y": 380,
        "wires": [
            []
        ]
    },
    {
        "id": "dbg_ok",
