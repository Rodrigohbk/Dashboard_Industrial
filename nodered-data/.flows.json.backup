    {
        "id": "03e68ce01740a6b0",
        "type": "function",
        "z": "19dee41e16af5081",
        "name": "Gerar Sequências (46)",
        "func": "const vars = [\n    // --- Floats (FP) ---\n    { name: 'Caldeira.TotalizadorAguaEntrada.Vazao', addr: 53090, qty: 2, type: 'f32' },\n    { name: 'Caldeira.RedutoraVapor.Valvula', addr: 53092, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorVapor.Vazao', addr: 53108, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorVaporANT.Vazao', addr: 53110, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorAguaBruta.Vazao', addr: 53084, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorAguaBrutaANT.Vazao', addr: 53086, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorAguaAbrandada.Vazao', addr: 53102, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorAguaAbrandadaANT.Vazao', addr: 53104, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorCondensado.Vazao', addr: 53096, qty: 2, type: 'f32' },\n    { name: 'Caldeira.TotalizadorCondensadoANT.Vazao', addr: 53098, qty: 2, type: 'f32' },\n    { name: 'Moenda.TotalizadorAguaEmbebicao.Vazao', addr: 53078, qty: 2, type: 'f32' },\n    { name: 'Moenda.TotalizadorAguaEmbebicaoANT.Vazao', addr: 53080, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorDosado.Vazao', addr: 53072, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorDosadoANT.Vazao', addr: 53074, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorClarificado.Vazao', addr: 53066, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorClarificadoANT.Vazao', addr: 53068, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorFiltrado.Vazao', addr: 53060, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorFiltradoANT.Vazao', addr: 53062, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorXarope.Vazao', addr: 53054, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorXaropeANT.Vazao', addr: 53056, qty: 2, type: 'f32' },\n    { name: 'Fabrica.MelFinal.Vazao', addr: 52016, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorMelFinal.Vazao', addr: 53048, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorMelFinalEND.Vazao', addr: 53050, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorLodo.Vazao', addr: 52824, qty: 2, type: 'f32' },\n    { name: 'Fabrica.TotalizadorLodoEND.Vazao', addr: 52826, qty: 2, type: 'f32' },\n    { name: 'Fabrica.MassaA.Nivel', addr: 52006, qty: 2, type: 'f32' },\n    { name: 'Fabrica.MassaB.Nivel', addr: 52002, qty: 2, type: 'f32' },\n    { name: 'Fabrica.Xarope.Nivel', addr: 52026, qty: 2, type: 'f32' },\n    { name: 'Gerador.TotalizadorG1.PotenciaAtiva', addr: 53042, qty: 2, type: 'f32' },\n    { name: 'Gerador.TotalizadorG1ANT.PotenciaAtiva', addr: 53044, qty: 2, type: 'f32' },\n    { name: 'Gerador.G1MAISG2.PotenciaAtiva', addr: 53154, qty: 2, type: 'f32' },\n    { name: 'Gerador.TotalizadorG1G2.PotenciaAtiva', addr: 53148, qty: 2, type: 'f32' },\n    { name: 'Gerador.TotalizadorG1G2ANT.PotenciaAtiva', addr: 53150, qty: 2, type: 'f32' },\n    { name: 'Gerador.TotalizadorG2.PotenciaAtiva', addr: 53142, qty: 2, type: 'f32' },\n\n    // --- Bits (4X) ---\n    { name: 'Fabrica.BMA01MassaA.Status', addr: 11000, qty: 1, type: 'bit', bit: 14 },\n    { name: 'Fabrica.BMA02MassaA.Status', addr: 11000, qty: 1, type: 'bit', bit: 15 },\n    { name: 'Fabrica.BMA03MassaA.Status', addr: 11001, qty: 1, type: 'bit', bit: 0 },\n    { name: 'Fabrica.BMA04MassaA.Status', addr: 11001, qty: 1, type: 'bit', bit: 1 },\n    { name: 'Fabrica.BMA05MassaA.Status', addr: 11001, qty: 1, type: 'bit', bit: 2 },\n    { name: 'Fabrica.BMA06MassaA.Status', addr: 11001, qty: 1, type: 'bit', bit: 13 },\n    { name: 'Fabrica.KONT01MassaB.Status', addr: 11000, qty: 1, type: 'bit', bit: 11 },\n    { name: 'Fabrica.KONT02MassaB.Status', addr: 11000, qty: 1, type: 'bit', bit: 12 },\n    { name: 'Fabrica.KONT03MassaB.Status', addr: 11001, qty: 1, type: 'bit', bit: 15 },\n    { name: 'Fabrica.KONT04MassaB.Status', addr: 11002, qty: 1, type: 'bit', bit: 5 },\n    { name: 'Fabrica.KONT05MassaB.Status', addr: 11002, qty: 1, type: 'bit', bit: 6 },\n    { name: 'Fabrica.KONT06MassaB.Status', addr: 11002, qty: 1, type: 'bit', bit: 8 }\n];\n\n// Salva os metadados no contexto do fluxo para a decodificação\nflow.set('vars_meta_231', vars);\n\nmsg.sequences = [];\nfor (let v of vars) {\n    msg.sequences.push({\n        name: v.name,\n        unitid: 255,\n        fc: 3,\n        address: v.addr,\n        quantity: v.qty\n    });\n}\n\nmsg.payload = Date.now();\nreturn msg;",
