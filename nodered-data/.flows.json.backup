r: 53252, qty: 2, type: 'f32' },\n    { name: 'Moenda.EmOperacao.Status', addr: 7600, qty: 1, type: 'bit', bit: 1 }\n];\n\nflow.set('vars_meta_mestre', vars);\n\nmsg.sequences = [];\nfor (let v of vars) {\n    msg.sequences.push({\n        name: v.name,\n        unitid: 255,\n        fc: 3,\n        address: v.addr,\n        quantity: v.qty\n    });\n}\n\nmsg.payload = Date.now();\nreturn msg;",
