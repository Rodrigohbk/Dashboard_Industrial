        "name": "Gerar Sequências (13)",
        "func": "const vars = [\n    // Gerador G1\n    { name: 'Gerador.G1.Tensao', addr: 54066, qty: 2, type: 'f32' },\n    { name: 'Gerador.G1.Corrente', addr: 54072, qty: 2, type: 'f32' },\n    { name: 'Gerador.G1.RPM', addr: 52000, qty: 2, type: 'f32' },\n    { name: 'Gerador.G1.Frequencia', addr: 54112, qty: 2, type: 'f32' },\n\n    // Gerador G2\n    { name: 'Gerador.G2.Tensao', addr: 54224, qty: 2, type: 'f32' },\n    { name: 'Gerador.G2.Corrente', addr: 54234, qty: 2, type: 'f32' },\n    { name: 'Gerador.G2.RPM', addr: 52040, qty: 2, type: 'f32' },\n    { name: 'Gerador.G2.Frequencia', addr: 54212, qty: 2, type: 'f32' },\n    \n    // DM (Double Word - Int32)\n    { name: 'Gerador.G2.PotenciaAtiva', addr: 32140, qty: 2, type: 'int32' },\n\n    // Concessionária\n    { name: 'Concessionaria.Tensao', addr: 54006, qty: 2, type: 'f32' },\n    { name: 'Concessionaria.Corrente', addr: 54012, qty: 2, type: 'f32' },\n    { name: 'Concessionaria.Potencia', addr: 54020, qty: 2, type: 'f32' },\n    { name: 'Concessionaria.Frequencia', addr: 54052, qty: 2, type: 'f32' }\n];\n\nflow.set('vars_meta_65', vars);\n\nmsg.sequences = [];\nfor (let v of vars) {\n    msg.sequences.push({\n        name: v.name,\n        unitid: 255,\n        fc: 3,\n        address: v.addr,\n        quantity: v.qty\n    });\n}\n\nmsg.payload = Date.now();\nreturn msg;",
