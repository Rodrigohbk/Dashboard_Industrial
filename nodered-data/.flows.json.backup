    {
        "id": "aad99a647eca10f5",
        "type": "function",
        "z": "c91848f1033f423c",
        "name": "Decodifica Float32 (CDAB)",
        "func": "if (!Array.isArray(msg.payload) || msg.payload.length < 2) {\n    node.warn('Float payload inesperado: ' + msg.topic);\n    return null;\n}\nconst reg_low  = msg.payload[0];\nconst reg_high = msg.payload[1];\nconst buf = Buffer.alloc(4);\nbuf.writeUInt16BE(reg_high & 0xFFFF, 0);\nbuf.writeUInt16BE(reg_low  & 0xFFFF, 2);\nconst val = buf.readFloatBE(0);\n\nif (!Number.isFinite(val)) return null;\n\nmsg.measurement = 'plc_data';\nmsg.tags = { plc: '228' };\nmsg.payload = {\n    fields: { [msg.topic]: val },\n    timestamp: Date.now()\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 860,
        "y": 400,
