        "func": "const vars = [\n    { name: 'Caldeira.Balao.Nivel', addr: 53000, qty: 2, type: 'f32' },\n    { name: 'Caldeira.Master.Pressao', addr: 52008, qty: 2, type: 'f32' },\n    { name: 'Caldeira.VaporSuperAquecido.Temperatura', addr: 52026, qty: 2, type: 'f32' },\n    { name: 'Caldeira.AguaAlimentacao.Pressao', addr: 52012, qty: 2, type: 'f32' },\n    { name: 'Caldeira.Desaerador.Nivel', addr: 52018, qty: 2, type: 'f32' },\n    { name: 'Caldeira.Desaerador.Pressao', addr: 52020, qty: 2, type: 'f32' },\n    { name: 'Caldeira.AguaAbrandada.Nivel', addr: 52014, qty: 2, type: 'f32' },\n    { name: 'Caldeira.RedutoraVapor.Valvula', addr: 52478, qty: 2, type: 'f32' },\n    { name: 'Caldeira.AguaClarificada.Nivel', addr: 52016, qty: 2, type: 'f32' },\n    { name: 'Caldeira.Desaerador.Temperatura', addr: 52022, qty: 2, type: 'f32' },\n    { name: 'Caldeira.ControleTemperaturaDesaerador.Valvula', addr: 52570, qty: 2, type: 'f32' },\n    { name: 'Caldeira.AguaEntrada.Vazao', addr: 52004, qty: 2, type: 'f32' },\n    { name: 'Caldeira.VaporSaida.Vazao', addr: 52002, qty: 2, type: 'f32' },\n    { name: 'Caldeira.AguaBruta.Vazao', addr: 52038, qty: 2, type: 'f32' },\n    { name: 'Caldeira.AguaAbrandada.Vazao', addr: 52024, qty: 2, type: 'f32' }\n];\n\nflow.set('vars_meta_220', vars);\n\nmsg.sequences = [];\nfor (let v of vars) {\n    msg.sequences.push({\n        name: v.name,\n        unitid: 255,\n        fc: 3,\n        address: v.addr,\n        quantity: v.qty\n    });\n}\n\nmsg.payload = Date.now();\nreturn msg;",
